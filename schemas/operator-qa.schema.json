{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awasali14/spec-kit-ai-loop-orchestrator/schemas/operator-qa.schema.json",
  "title": "AI Loop Operator QA Result",
  "type": "object",
  "required": ["mode", "scenarios", "validations"],
  "properties": {
    "mode": {"enum": ["automated", "assisted_manual", "not_runnable"]},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "steps", "expected", "actual", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "not_run", "accepted_risk"]},
          "severity": {"type": ["string", "null"], "enum": ["P0", "P1", "P2", "P3", null]},
          "flow_blocker": {"type": "boolean"},
          "steps": {"type": "array", "items": {"type": "string"}},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "decision": {
            "type": ["object", "null"],
            "properties": {
              "approver": {"type": "string"},
              "rationale": {"type": "string"},
              "scope": {"type": "string"},
              "timestamp": {"type": "string"}
            }
          }
        }
      }
    },
    "validations": {"type": "array", "items": {"type": "string"}}
  }
}
